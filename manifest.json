{
  "manifest_version": 3,
  "name": "Migalhas",
  "version": "0.4.0",
  "description": "Rejects non-essential cookie consent banners and clears cookies automatically.",
  "permissions": ["alarms", "browsingData", "cookies", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
